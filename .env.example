# Custom Node server
PORT=3000
HOSTNAME=0.0.0.0

# Required for host sessions: at least 32 random bytes.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Firebase Admin: service account JSON, or configure application default credentials.
FIREBASE_SERVICE_ACCOUNT=
# Project ID for application default credentials; not a secret.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Cloudflare R2 (S3-compatible storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public bucket/custom domain; otherwise /api/media proxies signed URLs.
R2_PUBLIC_URL=
