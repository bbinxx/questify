{
    "name": "questify",
    "version": "1.0.0",
    "description": "Interactive quiz game platform",
    "private": true,
    "scripts": {
        "dev": "nodemon server.js",
        "dev:next": "next dev --webpack",
        "build": "next build --webpack",
        "start": "NODE_ENV=production node server.js",
        "test": "node --test --test-isolation=none tests/*.test.cjs",
        "typecheck": "tsc --noEmit",
        "smoke": "node scripts/smoke.cjs"
    },
    "nodemonConfig": {
        "watch": [
            "server.js",
            "server/**",
            "lib/*.js",
            "next.config.mjs"
        ],
        "ext": "js,json",
        "ignore": [
            ".next/",
            ".next-dev/",
            "node_modules/"
        ],
        "delay": "1000"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1053.0",
        "@aws-sdk/s3-request-presigner": "^3.1053.0",
        "@types/canvas-confetti": "^1.9.0",
        "bcryptjs": "^3.0.3",
        "canvas-confetti": "^1.9.4",
        "firebase-admin": "^14.5.0",
        "framer-motion": "^12.27.1",
        "next": "^16.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20.10.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "nodemon": "^3.1.9",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=24"
    }
}
